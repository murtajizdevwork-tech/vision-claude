# =============================================================================
# Vision Academy — Environment Variables
# Copy this file to `.env` in the repo root for local development.
# On Vercel, set these in Project → Settings → Environment Variables.
# =============================================================================

# --- Frontend (Vite) ---
# Dev server port (Replit uses 8080 for the web artifact)
PORT=8080
# Asset base path; use "/" for production
BASE_PATH=/

# Optional: only needed when the frontend calls a remote API (e.g. separate Vercel project).
# Leave empty when frontend and API share the same origin (/api/*).
VITE_API_URL=

# --- Backend (Express / Vercel Serverless) ---
# Required locally; not used on Vercel (serverless — no app.listen).
# API server listens on this port during local dev (Replit workflow uses 8080).
# When running API separately from Vite, use 8080 and proxy /api in vite.config.ts.

# Neon PostgreSQL connection string (preferred)
NEON_DATABASE_URL=postgresql://neondb_owner:npg_gowkN6Eplq2c@ep-sweet-mountain-ay4byady-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Fallback if NEON_DATABASE_URL is not set
DATABASE_URL=

# Signs JWT tokens for admin auth (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-secret

# Optional
NODE_ENV=development
LOG_LEVEL=info

# Replit-only: initial admin password for seeding (not used by Vercel runtime)
ADMIN_PASSWORD=
